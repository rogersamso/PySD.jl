# Copy to .env and fill in.
# The address people open (a DuckDNS name works: myexplorer.duckdns.org),
# pointing at this server's IP address.
DOMAIN=myexplorer.duckdns.org
# The folder that holds the translated model (and its Excel files), on this server
MODEL_DIR=/srv/model
# Optional: the model's .jl file inside MODEL_DIR, if there is more than one
MODEL=
TITLE=World model
# Optional: folders inside MODEL_DIR with other input sheets; a sensitivity TSV
INPUT_DIRS=scenarios
SENSITIVITY=
# The explorer's memory limit
MEMORY=6g
